# DeepSeek API configuration for the AI interpreter (Phase 4).
# Copy this file to .env.local and fill in your key.
# Without DEEPSEEK_API_KEY the interpreter runs in offline rule-based mode.

# Required for AI mode (get one at https://platform.deepseek.com -> API Keys)
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown)
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Site URL for canonical/sitemap/robots (required before deployment)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
